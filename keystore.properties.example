# 复制本文件为 keystore.properties 并填入你自己的签名信息。
# 此文件已被 .gitignore 忽略，不会入库，请妥善保管。
#
# storeFile : 密钥库文件（PKCS12 格式 .p12）的绝对路径
# 若使用本机生成的 C:/temp/qingke_release.keystore.p12，则填该路径
# 若密钥库为 JKS 格式，请把 app/build.gradle.kts 里的 storeType 改为 "jks"
storeFile=C:/path/to/your/release-keystore.p12
storePassword=YOUR_STORE_PASSWORD
keyAlias=lightmark
keyPassword=YOUR_KEY_PASSWORD
