<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        轻刻为完全离线应用：不声明 INTERNET / ACCESS_NETWORK_STATE 权限，
        应用在技术上无法发起任何网络请求，所有数据仅存于本机。
        以下权限均与核心功能直接相关。
    -->
    <!-- 通知：待办到期提醒（Android 13+ 运行时申请） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 精确闹钟：用于到点提醒 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 闹钟响铃：震动 / 前台服务 / 唤醒 / 开机重排 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".LightMarkApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LightMark"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.LightMark">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 待办到期提醒广播 -->
        <receiver
            android:name=".receiver.ReminderReceiver"
            android:exported="false" />

        <!-- 提醒「推迟」广播（#46） -->
        <receiver
            android:name=".receiver.SnoozeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.lightmark.action.SNOOZE" />
            </intent-filter>
        </receiver>

        <!-- 闹钟到点广播 -->
        <receiver
            android:name=".receiver.AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.lightmark.action.ALARM_FIRE" />
            </intent-filter>
        </receiver>

        <!-- 开机后重排所有已启用闹钟 -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 闹钟响铃前台服务 -->
        <service
            android:name=".service.AlarmSoundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- 桌面小部件（#63）：待办概览 + 新建 -->
        <receiver
            android:name=".widget.TodoWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/todo_widget_info" />
        </receiver>

    </application>

</manifest>
